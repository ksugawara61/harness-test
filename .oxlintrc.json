{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@ksugawara61/code-lint/oxlintrc.json"],
  "ignorePatterns": [
    "dist",
    "src/server/graphql/*.generated.ts",
    "src/graphql/graphql-env.d.ts"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "code-lint/max-lines": [
          "error",
          {
            "maxLines": 300
          }
        ],
        "code-lint/no-cross-feature-import": "error",
        "code-lint/no-relative-cross-boundary": "error",
        "code-lint/use-nearest-shared-import": "error"
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "code-lint/no-logic-in-routes": [
          "error",
          {
            "allowHooks": ["useLocalSearchParams", "useServerDocumentContext"]
          }
        ],
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["src/features/**/*.tsx"],
      "rules": {
        "code-lint/no-handler-in-component": "error",
        "code-lint/no-inline-handler-logic": "error",
        "code-lint/no-test-id": "error",
        "code-lint/only-use-service-hooks": "error",
        "code-lint/use-service-single-component": "error"
      }
    },
    {
      "files": [
        "src/*.ts",
        "src/*.tsx",
        "src/app/*.tsx",
        "src/graphql/**",
        "src/lib/**",
        "src/test-utils/**",
        "src/ui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "allowTypeImports": true,
                "group": ["@/server", "@/server/**"],
                "message": "src/server はサーバー専用です。クライアントからは import type だけにしてください（API Route の src/app/api と src/server の中は除く）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/mocks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "allowTypeImports": true,
                "group": [
                  "@/server",
                  "@/server/**",
                  "!@/server/graphql/type-defs.generated.ts"
                ],
                "message": "src/mocks から src/server の値を import できるのは、リゾルバや秘密情報を含まない type-defs.generated.ts だけです"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "code-lint/use-feature-directory": "error",
        "code-lint/use-own-fragment": "error",
        "code-lint/use-service-file-name": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**", "@/route-tree.gen*"],
                "message": "フィーチャーからルーティング（src/app）を import しないでください。パスのパラメーターはルートのファイルで読み、ページに Props で渡します"
              },
              {
                "group": ["@tanstack/react-query", "@/lib/gql.ts"],
                "message": "フィーチャーからは TanStack Query と gqlFetch を直接使わず、@/lib/graphql-client.ts の useGraphQLQuery・useGraphQLMutation で操作を送ってください"
              },
              {
                "allowTypeImports": true,
                "group": ["@/server", "@/server/**"],
                "message": "src/server はサーバー専用です。クライアントからは import type だけにしてください（API Route の src/app/api と src/server の中は除く）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**/components/**"],
      "rules": {
        "code-lint/no-logic-in-components": "error"
      }
    },
    {
      "files": ["src/features/**/index.tsx"],
      "rules": {
        "code-lint/no-multiple-feature-exports": "error"
      }
    },
    {
      "files": ["src/features/**/service.ts"],
      "rules": {
        "code-lint/no-raw-setter-return": "error",
        "code-lint/no-router-in-use-service-return": [
          "error",
          {
            "hooks": ["useNavigation", "useRouter"]
          }
        ],
        "code-lint/use-service-handle-only": "error"
      }
    },
    {
      "files": ["src/features/**/graphqls/*.ts"],
      "rules": {
        "code-lint/use-graphql-operation-file": "error"
      }
    },
    {
      "files": ["src/features/**/mocks.ts"],
      "rules": {
        "code-lint/use-mocks-record": "error"
      }
    },
    {
      "files": ["src/features/**/index.tsx", "src/ui/*/index.tsx"],
      "rules": {
        "code-lint/use-stories-file": "error"
      }
    },
    {
      "files": ["src/**/stories.tsx"],
      "rules": {
        "code-lint/no-storybook-title": "error",
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["src/ui/**/*.tsx"],
      "rules": {
        "code-lint/no-style-prop-in-ui": "error",
        "code-lint/no-test-id": "error"
      }
    },
    {
      "files": ["src/**/test.tsx"],
      "rules": {
        "code-lint/no-event-in-yields": "error",
        "code-lint/no-expect-in-given-when": "error",
        "code-lint/no-raw-vitest-test": "error",
        "code-lint/no-waiting-in-when": "error",
        "code-lint/use-expression-when": "error"
      }
    },
    {
      "files": [
        ".dependency-cruiser.mjs",
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "oxfmt.config.mts",
        "vite.config.mts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
