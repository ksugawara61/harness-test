{
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@graphql-tools/mock": "^10.0.4",
    "@graphql-tools/schema": "^11.0.4",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "gql.tada": "^1.11.4",
    "graphql": "^17.0.2",
    "msw": "^3.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@ksugawara61/code-lint": "file:vendor/ksugawara61-code-lint-0.1.0.tgz",
    "@ksugawara61/spec": "file:vendor/ksugawara61-spec-0.1.0.tgz",
    "@storybook/react-native-web-vite": "^10.6.3",
    "@swc/core": "^1.16.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "main": "expo-router/entry",
  "name": "harness-test",
  "packageManager": "pnpm@11.1.2",
  "private": true,
  "scripts": {
    "build": "expo export -p web",
    "build:storybook": "storybook build",
    "codegen": "node scripts/gen-typedefs.ts && graphql-codegen && gql-tada generate output",
    "codegen:check": "pnpm codegen && git diff --exit-code -- src/graphql && gql-tada check",
    "dev": "EXPO_PUBLIC_API_MOCK=offline expo start --web",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint && pnpm lint:graphql && pnpm lint:json && pnpm lint:deps",
    "lint:deps": "depcruise src",
    "lint:graphql": "code-lint-graphql 'src/**/*.graphql'",
    "lint:json": "code-lint-sort-json-keys app.json package.json .oxlintrc.json tsconfig.json",
    "serve": "expo serve",
    "storybook": "storybook dev -p 6006",
    "test": "mkdir -p coverage && vitest run && check-spec-coverage .",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
